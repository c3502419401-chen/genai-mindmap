# genai-mindmap 容器版的配置模板
#
#   cp docker/.env.example .env      # 在仓库根目录
#   然后编辑 .env，至少把 MINDMAP_LLM_* 三项填了
#   docker compose up -d --build
#
# 为什么要放在**仓库根**的 .env：compose 的 `env_file: - .env` 与 `${VAR}`
# 变量插值都按 compose 文件所在目录解析，而 docker-compose.yml 就在根上。
# 根目录的 .env 已被 .gitignore 忽略（`.env` 与 `.env.*` 两条规则），密钥不会
# 进版本库；这份模板本身以 .example 结尾，例外保留。
#
# 与 backend/.env.example 的关系：那份是**本地开发**（uvicorn 直跑）用的，
# 默认 MINDMAP_LLM_MODE=demo；这份是**容器部署**用的，默认就是 model 形态，
# 因为它面对的是真实使用者。两边刻意不共享文件：容器版多几个只有容器才有的
# 键（HOME / HF_HOME / DOCLING_CACHE_DIR），开发版则不需要。

# ---------------------------------------------------------------- 模型（必填）
# demo = 占位图，不调模型；model = 真实调用。缺 MINDMAP_LLM_MODE 时 agent 会
# 因缺密钥直接报错，不会静默降级（代码缺省值不是 demo，见 backend/.env.example）。
MINDMAP_LLM_MODE=model
MINDMAP_LLM_BASE_URL=https://api.deepseek.com/v1
MINDMAP_LLM_API_KEY=
MINDMAP_LLM_MODEL=deepseek-chat

# ---------------------------------------------------------------- 数据库
# 容器里的路径由 docker-compose.yml 的 environment 段固定成 /data/mindmaps.db
# （卷上），这里**不用**写。留空即表示"用 compose 那份"。
# 只有想把它指到别处（比如换成 bind mount 到宿主机某个目录）才在这里覆盖。
# MINDMAP_DB_PATH=

# ---------------------------------------------------------------- 可选能力
# 语音输入（阿里云百炼 Qwen-Audio-ASR）。不配时 .wav 上传返回 422。
DASHSCOPE_API_KEY=

# 流式生成的总开关，设为 0 关闭 /api/agent/runs/stream。
MINDMAP_AGENT_ENABLED=1

# 引用语义复核（ONNX 模型）。默认关；开之前先确认卷里有模型、内存够。
MINDMAP_NLI_ENABLED=0
MINDMAP_NLI_MODEL_DIR=

# 知识库检索 / 入库。
MINDMAP_LIBRARY_SEARCH=1
MINDMAP_LIBRARY_REMEMBER=1

# 主题生成的外部知识检索（中文维基 / 快懂百科 / arXiv / OpenAlex / Crossref）。
# 外网不通的机器上写 0，行为退回"纯主题生成"（不等待、不发请求）。
MINDMAP_EXTERNAL_KNOWLEDGE=1

# 外部检索的出口。**这里是容器版与开发版最大的一个坑。**
# 开发机的缺省值是 http://127.0.0.1:7897（作者本机的 Clash），但容器里的
# 127.0.0.1 是容器自己，写它等于"哪都连不上"，而且失败是 5-6 秒后静默返回空。
# compose 已经把它默认成 none（直连）；要真的走宿主机代理时改成：
#   MINDMAP_EXTERNAL_PROXY=http://host.docker.internal:7897
# （Linux 上 host.docker.internal 需要 compose 里加 extra_hosts，见 docs/DOCKER.md）
MINDMAP_EXTERNAL_PROXY=none

# DeepSeek 的 Search / Fetch 两个外部源，默认关。开要 key，不填会回落到
# MINDMAP_LLM_API_KEY / MINDMAP_LLM_BASE_URL。
MINDMAP_EXTERNAL_DEEPSEEK_SEARCH=0
MINDMAP_EXTERNAL_DEEPSEEK_FETCH=0
MINDMAP_DEEPSEEK_TOOLS_API_KEY=
MINDMAP_DEEPSEEK_TOOLS_BASE_URL=
# DeepSeek 自己的出口，缺省 none（直连 api.deepseek.com）。
MINDMAP_DEEPSEEK_TOOLS_PROXY=none

# 图存储（Neo4j）。密码没有默认值：不填等于没配置，写接口抛错、读接口返回空。
# 容器里要连宿主机的 Neo4j 用 host.docker.internal:7687，不要写 127.0.0.1。
MINDMAP_NEO4J_URI=
MINDMAP_NEO4J_USER=
MINDMAP_NEO4J_PASSWORD=
MINDMAP_NEO4J_DATABASE=

# ---------------------------------------------------------------- 模型下载源
# docling 从 HuggingFace 拉版面/表格模型。国内直连 huggingface.co 通常不通。
# compose 里缺省已设成 https://hf-mirror.com；写在这里是为了能一眼看到、能覆盖。
# 出网正常（或有局域网镜像）时改成 https://huggingface.co 或自建端点。
HF_ENDPOINT=https://hf-mirror.com

# ---------------------------------------------------------------- 容器内路径
# 下面这些 compose 里已经写死了，列在这里只是为了让"数据在哪"一眼可见。
# 真要改，改 docker-compose.yml 的 environment，否则两边会打架（compose 的
# environment 覆盖 env_file，所以在这里改是无效的——列出来是为了防误改）。
# HOME=/data
# HF_HOME=/models/huggingface
# DOCLING_CACHE_DIR=/models/docling

# ---------------------------------------------------------------- 构建参数
# 国内 pip 镜像。torch 的 CPU 轮子固定在官方源，不走这个。
PIP_INDEX_URL=https://pypi.org/simple
# 1 = 装 LibreOffice 支持 .doc/.ppt（约 1.5GB，会顶穿 2.5GB 体积预算）
WITH_OFFICE=0
# 前端对外端口
WEB_PORT=80

