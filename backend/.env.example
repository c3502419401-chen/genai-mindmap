# 本地开发照抄本文件即演示模式（占位图，不调模型）。
# 注意：代码里的缺省值**不是** demo——完全不设 MINDMAP_LLM_MODE 时，agent 会因
# 缺密钥直接报错，不会静默降级成占位图。要真实模型就改成 model 并填下面三项。
# 密钥不得提交到仓库。此文件不会自动加载，需在启动服务前设置到系统环境变量。
MINDMAP_LLM_MODE=demo
MINDMAP_LLM_BASE_URL=https://example.com/v1
MINDMAP_LLM_API_KEY=
MINDMAP_LLM_MODEL=
# 可选：SQLite 文件路径（默认 backend/data/mindmaps.db）
MINDMAP_DB_PATH=
# 可选：语音转写（百炼 Qwen-Audio-ASR），不配时 .wav 上传返回 422
DASHSCOPE_API_KEY=
# 可选：LibreOffice 的 soffice 路径，处理 .doc / .ppt 等旧格式；不配则从 PATH 找
MINDMAP_SOFFICE_CMD=
# 可选：设为 0 关闭 /api/agent/runs/stream
MINDMAP_AGENT_ENABLED=1
# 可选：引用语义复核（ONNX 模型），默认关闭，只做机械核验
MINDMAP_NLI_ENABLED=0
MINDMAP_NLI_MODEL_DIR=
MINDMAP_NLI_MIN_FREE_MB=
# 可选：知识库检索，默认开。设为 0 时 rag_query 只看本次请求带来的材料，
# 不看知识库（行为与接入知识库之前逐字节相同，便于定位"这条召回是不是库带进来的"）。
MINDMAP_LIBRARY_SEARCH=1

# 图存储（Neo4j）。密码没有默认值：不填就等于没配置，写接口抛错、读接口返回空。
# 不设 URI/USER/DATABASE 时分别用 bolt://127.0.0.1:7687 / neo4j / neo4j。
MINDMAP_NEO4J_URI=
MINDMAP_NEO4J_USER=
MINDMAP_NEO4J_PASSWORD=
MINDMAP_NEO4J_DATABASE=
