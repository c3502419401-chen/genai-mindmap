[Unit]
Description=genai-mindmap API (FastAPI + uvicorn)
Documentation=https://github.com/RPeGio/genai-mindmap
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=genai
Group=genai
WorkingDirectory=/opt/genai-mindmap/backend

# 密钥等运行时配置放在这里，仓库里不存（install.sh 会创建，权限 0640 root:genai）。
# 前缀 `-` 会让文件缺失时照常启动：MINDMAP_DB_PATH 随之丢失、回落到代码目录下的
# 默认路径，而 ProtectSystem=strict 让那里只读，保存与读取会全 500 而启动日志正常。
# 宁可起不来，也不要带病运行。
EnvironmentFile=/etc/genai-mindmap/env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# 下面这条不只是整洁：docling 第一次解析 docx/pptx 会下载版面模型到
# $HOME/.cache/docling。服务用户的 HOME 若落在 /home 下，会被 ProtectHome
# 挡在外面（下载失败 → 上传直接 422）。指到可写的数据目录里最稳。
Environment=HOME=/var/lib/genai-mindmap

# --proxy-headers + --forwarded-allow-ips：nginx 在 127.0.0.1 上反代，
# 让 request_id 日志与限流能看到真实来源 IP。
#
# 只开 1 个 worker：SQLite 是单写者，开多 worker 只会让写冲突变成
# "database is locked" 的偶发 500；2C2G 上多进程也吃内存。
ExecStart=/opt/genai-mindmap/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 1 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1 \
    --no-server-header --timeout-keep-alive 65 \
    --timeout-graceful-shutdown 15
Restart=always
RestartSec=3
# 生成预算 600 秒（RunBudget.max_seconds）。20 秒会让任何一次 systemctl restart
# 把正在跑的生成硬断掉，用户看到的是流突然结束、候选丢失。90 秒留给它收尾，
# 真正的优雅关闭窗口由 uvicorn 的 --timeout-graceful-shutdown 15 控制。
TimeoutStopSec=90
KillSignal=SIGINT

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# 只允许写数据目录（原先还列了 /var/log/genai-mindmap，但没有任何代码往那里写
# ——日志走 journal，备份日志是 /var/log/genai-mindmap-backup.log 这个文件，
# 而 install.sh 也从不创建那个目录——systemd 为缺失的 ReadWritePaths 建 namespace
# 会失败，单元直接起不来（226/NAMESPACE）。多写一条路径就是多一个启动条件。
ReadWritePaths=/var/lib/genai-mindmap

StandardOutput=journal
StandardError=journal
SyslogIdentifier=genai-mindmap

[Install]
WantedBy=multi-user.target
