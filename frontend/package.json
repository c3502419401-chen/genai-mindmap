{
  "name": "genai-mindmap-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:cost": "node scripts/measure-test-cost.mjs --label idle --out _test-cost-idle.json",
    "test:cost:report": "node scripts/report-test-cost.mjs --idle scripts/_test-cost-idle.json --loaded scripts/_test-cost-loaded.json --solo scripts/_test-cost-solo.json --baseline scripts/test-cost-baseline.json --md docs/TEST-LOAD-SENSITIVITY-TABLE.md",
    "test:cost:gate": "node scripts/check-test-cost.mjs --gate",
    "test:journey": "node ../docs/acceptance-scripts/journey.spec.mjs",
    "type-check": "vue-tsc --noEmit",
    "gen:api": "npx --yes --prefer-offline openapi-typescript@7.13.0 ../backend/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
