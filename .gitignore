# dependencies
node_modules/
.pnp
.pnp.js

# build output
dist/
dist-ssr/
build/
*.tsbuildinfo

# env & secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 代理客户端的本机配置：`clash-verge.yaml` 里只有 `mixed-port: 7890` 这种
# "我这台机器上代理开在哪个端口"的信息，对别人没有任何意义。它随一次上游提交
# 混进来过，所以除了删掉那个文件，这里也留一条规则防止再被带进来。
clash-verge.yaml
clash*.yaml

# runtime data
data/
uploads/
exports/
eval/results/
eval/reports/

# Python development
.venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.db
# 覆盖率产物：pytest-cov 每次运行都会重写，不该进仓库
.coverage
.coverage.*
coverage.xml
htmlcov/

# AI Agent contracts
# 规范要共享才有效：AGENTS.md 落到仓库里，两个人看到的才是同一份。
# 各人的本地覆盖走 AGENTS.local.md（仍在忽略范围）。
AGENTS.md
!AGENTS.md
AGENTS.local.md
*.gz

# codex 派活脚本的产物：报告与事件流都属于一次性排障材料
codex-report-*.md
codex-raw-*.log

# 真浏览器验证的临时目录（截图、种子脚本、对比脚本）。产物值得留，但不该进版本库
.visioncheck/

# review 时随手导出的补丁（`.review-pr23.diff` 这种）：是给当时那次评审看的，
# 结论留在 PR 评论里就够了，文件本身进版本库只会让后人以为它还有用。
.review-*.diff
.review-*.patch

# 鱼骨几何的一次性验证脚本与截图（.visioncheck 的兄弟目录，同样不进版本库）
frontend/verify-fishbone.html
frontend/verify-fishbone.ts
frontend/verify-shots/

# 本地启动脚本：里面是真实的 API key（DeepSeek + 阿里 MaaS）。
# 启动方式见文件本身；要给别人用就照 .env.example 另写一份带占位符的。
run-backend.bat

# Basic Auth 口令文件（`htpasswd -c … `）。nginx 那层已经弃用（鉴权在应用层的
# 账号体系里），但这条规则留着：它是 `htpasswd` 的默认产物名，里面是密码哈希，
# 和 `.env` 同一类东西。哪天有人想起来在外层反代上加一道口令，这条正好挡住
# "提交一次就把口令发给所有能读仓库的人"。
.htpasswd
**/.htpasswd

# 验收测量用的图片/语音样本：由 backend/scripts/make_acc_media.py 重建
backend/scripts/acc_media/

# 探针 / 测量脚本的产物：`measure_*.py` 的默认输出（`DEFAULT_OUT = "scripts/_xxx.json"`），
# 属于一次性产物，不该进版本库。
#
# 例外两条，它们被 docs 当"留档的实测结果"引用（docs/SUBAGENT-VS-SELFCHECK.md：两份
# 结果留在 `_selfcheck_sliced.json` 与 `_selfcheck_once.json`）——删了就没有复算依据了。
#
# 这条规则不是"记得清"而是被检查的：`backend/scripts/check_script_hygiene.py` 的
# artifacts 一档要求"已进版本库的产物必须被 docs 引用"，反过来说未跟踪的产物必须被
# 这里覆盖住，否则它报"游离产物"。
backend/scripts/_*.json
!backend/scripts/_selfcheck_once.json
!backend/scripts/_selfcheck_sliced.json

# ruff 的缓存目录（`python -m ruff check .` 在 backend/ 下生成）
.ruff_cache/

